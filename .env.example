# 多模态企业智能客服系统 · 配置模板
#
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 任何密钥字段留空时，对应能力自动进入降级模式（见 docs/架构说明.md 第 7 节）。

# --- 多模态（图片理解）：OpenAI 兼容网关 ---
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen3.5-omni-plus
QWEN_VISION_TIMEOUT=60

# --- 本地对话模型（默认通道，OpenAI 兼容端点）---
# 本机已装 qwen2.5:latest（7.6B）与 deepseek-r1:8b，直接用现成的即可；
# 追求速度可换成更小的指令模型，例如 qwen3:4b（需先 ollama pull）。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT=120

# --- 备用对话通道（provider 留空则禁用）---
FALLBACK_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- 本地嵌入模型（BGE-M3，1024 维）---
EMBEDDING_MODEL_PATH=D:/ai_models/modelscope_cachessss/models/models/BAAI--bge-m3/snapshots/master
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8

# --- 检索参数（打分公式见 docs/架构说明.md 第 5 节；阈值在 M7 用真实语料标定）---
RETRIEVE_TOP_K=4
RETRIEVE_CANDIDATES=12
RETRIEVE_MIN_SCORE=0.35
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# --- 存储 ---
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
DOCS_DIR=data/docs

# --- 服务 ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# 启动时后台预热对话模型与嵌入模型：本地大模型冷启动 70s+，预热后单轮约 7s
WARMUP_ON_START=true
# 单轮回答的最大 token 数
CHAT_MAX_TOKENS=700
# 拼进提示词的历史轮数（读写 messages 表）
HISTORY_TURNS=6
# 兜底回答是否交给模型润色。默认 false：兜底话术必须逐字可控（不许编造）
FALLBACK_USE_MODEL=false
