# 多模态企业智能客服系统 · 配置模板
#
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 任何密钥字段留空时，对应能力自动进入降级模式（见 docs/架构说明.md 第 7 节）。

# --- 模型总开关 ---
# auto：真实模型（本地 Ollama → 备用通道 → 视觉通道链）
# mock：离线确定性假模型，用于「先跑通后端逻辑」、前端联调与无网演示
LLM_MODE=auto

# --- 图片理解（视觉）通道：本地 Ollama 优先，留空回落到下面的 QWEN_* ---
# 本地方案（推荐，完全离线）：
#   ollama pull qwen2.5vl:3b        # 3.2GB，非思考模型、中文 OCR 强
#   VISION_BASE_URL=http://127.0.0.1:11434/v1
#   VISION_MODEL=qwen2.5vl:3b
# 注意：6GB 显存下文本模型与视觉模型不会同时常驻，每张图片问答会有一次 5~10s 的模型换入换出。
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_MODEL=qwen2.5vl:3b
VISION_API_KEY=
VISION_TIMEOUT=120
# 本地视觉模型不可用时是否自动回退云端网关（需配置下面的 QWEN_API_KEY）
VISION_AUTO_CLOUD_FALLBACK=true
# 编码前等比缩放的长边像素（0=不缩放）；本地小模型对大图很慢
VISION_MAX_SIDE=1280

# --- 云端多模态网关（旧名，保留兼容；也是本地视觉的回退通道）---
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen3.5-omni-plus
QWEN_VISION_TIMEOUT=60

# --- 思考型模型适配 ---
# qwen3 / deepseek-r1 等推理模型会把预算花在思考上（实测正文为空），
# 打开后自动追加 /no_think 软开关；非思考模型不受影响。
DISABLE_THINKING=true

# --- 本地对话模型（默认通道，OpenAI 兼容端点）---
# 本机已装 qwen2.5:latest（7.6B）与 deepseek-r1:8b，直接用现成的即可；
# 追求速度可换成更小的指令模型，例如 qwen3:4b（需先 ollama pull）。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT=120

# --- 备用对话通道（provider 留空则禁用）---
FALLBACK_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- 本地嵌入模型（BGE-M3，1024 维）---
EMBEDDING_MODEL_PATH=D:/ai_models/modelscope_cachessss/models/models/BAAI--bge-m3/snapshots/master
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8

# --- 检索参数（打分公式见 docs/架构说明.md 第 5 节；阈值在 M7 用真实语料标定）---
RETRIEVE_TOP_K=4
RETRIEVE_CANDIDATES=12
RETRIEVE_MIN_SCORE=0.35
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# --- 存储 ---
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
DOCS_DIR=data/docs

# --- 服务 ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# 启动时后台预热对话模型与嵌入模型：本地大模型冷启动 70s+，预热后单轮约 7s
WARMUP_ON_START=true
# 单轮回答的最大 token 数
CHAT_MAX_TOKENS=700
# 拼进提示词的历史轮数（读写 messages 表）
HISTORY_TURNS=6
# 兜底回答是否交给模型润色。默认 false：兜底话术必须逐字可控（不许编造）
FALLBACK_USE_MODEL=false

# --- 检索增强（v2.1）：重排 + 多路融合 + 动态 TopK ---
# 本地重排模型（2.1GB，CPU 加载约 6.5s、6 条打分约 0.9s）；留空则退化为词面覆盖率兜底
RERANK_MODEL_PATH=D:/ai_models/modelscope_cache/models/rerank/BAAI/bge-reranker-large
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=512
# 启动时后台预热重排模型（占内存，默认懒加载）
WARMUP_RERANKER=false
# 动态 TopK：绝对下限 / 相对地板 / 断崖比例 / 条数上限 / 进入重排的候选数
RERANK_MIN_SCORE=0.10
RERANK_RELATIVE_FLOOR=0.35
RERANK_CLIFF_RATIO=0.5
RERANK_TOP_K_MAX=6
RERANK_CANDIDATES=24

# --- 三档置信（高置信检索 / 中置信反问 / 低置信拒答）---
CONFIDENCE_HIGH=0.50
CONFIDENCE_LOW=0.10
CLARIFY_MAX_ROUNDS=2
# 边界区间的 LLM 实体对齐确认（默认关，省一次模型调用）
LLM_ALIGN_ENABLED=false

# --- 联网兜底检索：百炼 MCP（EnhancedSearch）---
# 仅当内部重排 top1 < MCP_TRIGGER_TOP1 时触发；联网结果单独标注来源、不入工单
MCP_ENABLED=true
MCP_BASE_URL=
MCP_API_KEY=
MCP_TIMEOUT=45
MCP_MAX_RESULTS=5
MCP_TOOL_NAME=
MCP_TRIGGER_TOP1=0.35
# 问题内容词覆盖率低于此值也联网（重排分会被型号词虚高，需要这个正交信号）
MCP_TRIGGER_COVERAGE=0.34
MCP_REQUIRE_ENTITY_MATCH=true
